# Server Port
PORT=5000

# MongoDB Connection String (Local or MongoDB Atlas)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.y4gpmnm.mongodb.net/rize?retryWrites=true&w=majority&appName=Cluster0
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.y4gpmnm.mongodb.net/rize?retryWrites=true&w=majority&appName=Cluster0

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d

# Allowed Frontend URLs for CORS (comma-separated if multiple, e.g. http://localhost:5173,https://your-app.vercel.app)
CLIENT_URL=http://localhost:5173

# Environment (development | production)
NODE_ENV=production

# Optional: API base URL if hosting frontend separately from backend
# In local dev with Vite proxy, leave empty or '/api'
# In production (e.g. Vercel), set to: https://your-backend.onrender.com/api
VITE_API_URL=/api

# Backend origin for static files (e.g., resumes, uploads)
# In local dev: http://localhost:5000
# In production: https://your-backend.onrender.com
VITE_BACKEND_URL=http://localhost:5000

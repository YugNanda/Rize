# API base URL for Rize backend
# In local dev with Vite proxy: /api
# In production (e.g. Vercel): https://rize-backend.vercel.app/api
VITE_API_URL=https://rize-backend.vercel.app/api

# Backend origin for static files (e.g., resumes, uploads)
# In local dev: http://localhost:5000
# In production: https://rize-backend.vercel.app
VITE_BACKEND_URL=https://rize-backend.vercel.app
